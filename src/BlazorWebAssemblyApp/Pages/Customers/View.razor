@page "/customers/view/{id:int}"
@using BlazorWebAssemblyApp.Services
@using BlazorWebAssemblyApp.Shared
@inject ICustomerService Api

<h3>View Customer Id = @Id</h3>

<Loader IsLoading="@IsLoading">

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@customer.Name</h5>
            <p class="card-text">@customer.Email</p>


            <button @onclick="@ChangeVisible">Show/Hide Shipping Address</button>

            @if (VisibleShippingAddress)
            {
                <div>
                    <h6>Shipping Addresss</h6>
                    @customer.ShippingAddress.Country
                </div>
            }

            <button @onclick="@Toggle">Toggle Active</button>

            <p id="active-label" class="@(isActive ? "active" : "")">Lorem ipsum</p>

            <input type="text" @bind-value="@customer.Name" @bind-value:event="oninput" />
            <input type="text" @bind="@customer.Name" @bind:event="oninput" />            

            <button @onclick="@ChangeName">Change Name</button>
            

        </div>

    </div>
</Loader>



@code {


    // private string newName;

    private void ChangeName()
    {
        customer.Name = customer.Name + "!";
    }


    [Parameter]
    public int Id { get; set; }    

    private Customer? customer;

    private bool IsLoading => customer == null;

    private bool VisibleShippingAddress;

    private void ChangeVisible()
    {
        VisibleShippingAddress = !VisibleShippingAddress;
    }


    private bool isActive = false;

    private void Toggle()
    {
        isActive = !isActive;

        customer.Name = customer.Name + "!";        
    }

    
    protected override async Task OnParametersSetAsync()
    {
        customer = await Api.Get(Id);
    }


}
