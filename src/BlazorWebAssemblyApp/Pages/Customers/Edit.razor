@page "/customers/edit/{id:int}"
@using BlazorWebAssemblyApp.Services
@using BlazorWebAssemblyApp.Shared
@using Blazored.FluentValidation
@inject ICustomerService Api

<h3>Edit</h3>

<Loader IsLoading="@IsLoading">

    <EditForm Model="@customer" OnValidSubmit="@HandleSave"  >

       @*  <DataAnnotationsValidator /> *@

       <FluentValidationValidator />


        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name: </label>
            <InputText id="name" @bind-Value="customer.Name" class="form-control"  />
            <ValidationMessage For="()=>customer.Name" />

        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email: </label>
            <InputText id="email" @bind-Value="customer.Email" class="form-control" />
            <ValidationMessage For="() => customer.Email" />
        </div>

        
        <div class="mb-3">
            <label for="city" class="form-label">City: </label>
            <InputText id="city" @bind-Value="customer.ShippingAddress.City" class="form-control" />
            <ValidationMessage For="() => customer.ShippingAddress.City" />
        </div>

        <div class="mb-3">
            <label for="city" class="form-label">City: </label>
            <InputText id="city" @bind-Value="customer.ShippingAddress.City" class="form-control" />
            <ValidationMessage For="() => customer.ShippingAddress.City" />
        </div>


        <button type="submit" class="btn btn-primary">Save</button>
        
      

    </EditForm>

  



</Loader>

@code {

    private bool IsLoading => customer == null;


    [Parameter]
    public int Id { get; set; }

    private Customer? customer;

    protected override async Task OnParametersSetAsync()
    {
        customer = await Api.Get(Id);
    }


    private async Task HandleSave()
    {
        // TODO: Call Api.Update(customer);

       
    }

}
