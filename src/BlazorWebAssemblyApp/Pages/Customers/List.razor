@page "/customers"
@inject ICustomerService Api 
@using BlazorWebAssemblyApp.Services
@using BlazorWebAssemblyApp.Shared
@using Domain.Models

<h3>Customers</h3>

<p>Hello Customers!</p>

@if (customers is null)
{
    <p>Customers is loading...</p>
}
else
{
  <CustomerTable Customers="@customers">
      <HeaderTemplate>            
            <th>Name</th>
            <th>Email</th>
            <th>IsDeleted</th>
            <th>City</th>
            <th>Country</th>
            <th>Shipping City</th>
            <th>Shippimg Country</th>
      </HeaderTemplate>

      <RowTemplate Context="Customer">            
            <td>@Customer.Name</td>
            <td>@Customer.Email</td>
            <th>@Customer.IsDeleted</th>
            
            <AddressComponent Address="@Customer.HomeAddress" />
            <AddressComponent Address="@Customer.ShippingAddress" />
                       
      </RowTemplate>

  </CustomerTable>
}

@code {


    // This is equivalent to: @inject ICustomerService Api (declared at the top of this .razor file).
    // [Inject]
    // public ICustomerService Api { get; set; }

    private IEnumerable<Customer>? customers;
   
    protected override async Task OnInitializedAsync()
    {
        customers = await Api.GetAll();
    }



}


