@page "/customers"
@inject ICustomerService Api 
@using BlazorWebAssemblyApp.Services
@using BlazorWebAssemblyApp.Shared
@using Domain.Models

<h3>Customers</h3>

<Header />


<!-- Search Panel -->
<div id="search-panel">
    <input type="text" placeholder="What do you search?" @bind-value="@SearchText" />
    <button class="btn btn-primary" onclick=@Search>Search</button>
</div>

<Loader IsLoading="@isLoading">
   
        <CustomerTable Customers="@customers">
            <HeaderTemplate>
                <th>Name</th>
                <th>Email</th>
                <th>IsDeleted</th>
                <th>Street</th>
                <th>City</th>
                <th>Country</th>
                <th>Shipping Street</th>
                <th>Shipping City</th>
                <th>Shippimg Country</th>
            </HeaderTemplate>

            <RowTemplate Context="Customer">
                <td>@Customer.Name</td>
                <td>@Customer.Email</td>
                <th>@Customer.IsDeleted</th>
            
                <AddressComponent Address="@Customer.HomeAddress" />
                <AddressComponent Address="@Customer.ShippingAddress" />
                       
            </RowTemplate>

        </CustomerTable>
  
</Loader>


@code {

    private string SearchText { get; set; } = "a";

    private async Task Search()
    {
        Console.WriteLine($"Searching {SearchText}...");

    }
}
