@page "/customers"
@inject ICustomerService Api 
@using BlazorWebAssemblyApp.Services
@using Domain.Models

<h3>Customers</h3>

<p>Hello Customers!</p>

@if (customers is null)
{
    <p>Customers is loading...</p>
}
else
{
    <ul>
        @foreach (var customer in customers)
        {
            <li>@customer.Id @customer.Name @customer.Email</li>
        }

    </ul>

}

@code {


    // This is equivalent to: @inject ICustomerService Api (declared at the top of this .razor file).
    // [Inject]
    // public ICustomerService Api { get; set; }


    private IEnumerable<Customer>? customers;
   
    protected override async Task OnInitializedAsync()
    {
        customers = await Api.GetAll();
    }



}


