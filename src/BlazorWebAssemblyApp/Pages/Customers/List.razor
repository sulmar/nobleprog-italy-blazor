@page "/customers"
@inject ICustomerService Api 
@inject NavigationManager Nav
@using BlazorWebAssemblyApp.Services
@using BlazorWebAssemblyApp.Shared
@using Domain.Models

<h3>Customers</h3>

<Header />

<SearchPanel ValueChanged="@OnSearch" />


<Loader IsLoading="@isLoading">
   
        <CustomerTable Customers="@customers">
            <HeaderTemplate>
                <th>Name</th>
                <th>Email</th>
                <th>IsDeleted</th>
                <th>Street</th>
                <th>City</th>
                <th>Country</th>
                <th>Shipping Street</th>
                <th>Shipping City</th>
                <th>Shippimg Country</th>
                <th>Actions</th>
            </HeaderTemplate>

            <RowTemplate Context="Customer">
                <td>@Customer.Name</td>
                <td>@Customer.Email</td>
                <td>@Customer.IsDeleted</td>
            
                <AddressComponent Address="@Customer.HomeAddress" />
                <AddressComponent Address="@Customer.ShippingAddress" />

                <td>
                    <a href="/customers/view/@Customer.Id" class="btn btn-primary" >View</a>
                    <button @onclick="@OnDelete" class="btn btn-danger">Delete</button>
                </td>
                       
            </RowTemplate>

        </CustomerTable>
  
</Loader>


@code {

    private async Task OnDelete()
    {
        Console.WriteLine("Are you sure?");

        Nav.NavigateTo("/");

    }

    private async Task OnSearch(string searchText)
    {
        Console.WriteLine($"Searching customers {searchText}...");
    }
}
