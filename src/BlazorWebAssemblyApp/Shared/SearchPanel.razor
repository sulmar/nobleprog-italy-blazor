
<!-- Search Panel -->
<div id="search-panel">
    <input type="text" placeholder="What do you search?" @bind-value="@SearchText" @ref="searchTextRef" />
    <button class="btn btn-primary" onclick=@Search>Search</button>
</div>


@code {

    private ElementReference searchTextRef;

    private string SearchText { get; set; } = "a";


    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }


    public async Task Search()
    {
        await ValueChanged.InvokeAsync(SearchText); 

    }

    // often mistake
    // protected override async Task OnInitializedAsync()
    // {
    //     await searchTextRef.FocusAsync();
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await searchTextRef.FocusAsync();
        }
    }
}
